# --- Local API server (apps/api-server) ---
PORT=4000
DATABASE_URL=postgres://matriwatch:matriwatch@localhost:5432/matriwatch
# Optional: use this instead of DATABASE_URL for hosted Supabase Postgres.
# Use the Supabase pooled connection string and keep SSL enabled.
SUPABASE_DATABASE_URL=
DATABASE_SSL=true
NODE_ENV=development

# --- ML service (services/ml) ---
MATRIWATCH_MODEL_DIR=services/ml/models/current_ppd

# --- Web dashboard (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_MATRIWATCH_ML_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mobile app (apps/mobile) ---
EXPO_PUBLIC_MATRIWATCH_API_URL=http://localhost:4000/api
EXPO_PUBLIC_MATRIWATCH_ML_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MOTHER_ID=

# --- Optional Kaggle CLI credentials for scripts/download_datasets.py ---
KAGGLE_USERNAME=
KAGGLE_KEY=
