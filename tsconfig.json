{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/mobile/*"
      ],
      "@matriwatch/shared": [
        "packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "packages/shared/**/*.ts",
    "nativewind-env.d.ts"
  ]
}